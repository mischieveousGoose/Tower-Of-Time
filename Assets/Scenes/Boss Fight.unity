  m_Script: {fileID: 11500000, guid: 4f2aacf72d8f86f4a9343146aae5f711, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  conversation:
  - face: {fileID: 2611391267376642991, guid: bf81bbcd4aaff4444a027b820aad570d, type: 3}
    cName: Steve
    text: Hey Brock, I didn't expect it to be that difficult to get up here.
  - face: {fileID: 2611391267376642991, guid: bf81bbcd4aaff4444a027b820aad570d, type: 3}
    cName: Steve
    text: Anyway what are you doing here? I though it was just me.
  - face: {fileID: -6459963565631279935, guid: 835ae7c6c66344341b6c6f87b6ed8727, type: 3}
    cName: Brock
    text: I'm sorry...
  - face: {fileID: 2611391267376642991, guid: bf81bbcd4aaff4444a027b820aad570d, type: 3}
    cName: Steve
    text: Why?
  - face: {fileID: -6459963565631279935, guid: 835ae7c6c66344341b6c6f87b6ed8727, type: 3}
    cName: Brock
    text: I can't let anyone know the truth.
  face: {fileID: 1148832758}
  nameText: {fileID: 1864852939}
  dialogueText: {fileID: 1729762679}
  dialogueSpeed: 0.04
  thisDialogue: 1
  startedDialogue: 0
  dialogueBox: {fileID: 662802073}
